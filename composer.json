{
    "name": "sergkeim/php-cloudflare-api",
    "description": "PHP Client for Cloudflare API.",
    "type": "library",
    "keywords": ["cloudflare", "cloudflare-api", "api"],
    "license": "MIT",
    "authors": [
        {
            "name": "Sergkei Melingk",
            "email": "sergio11of@gmail.com",
            "homepage": "https://github.com/SergkeiM",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/SergkeiM/php-cloudflare-api",
        "issues": "https://github.com/SergkeiM/php-cloudflare-api/issues",
        "email": "sergio11of@gmail.com",
        "docs": "https://sergkeim.github.io/php-cloudflare-api/"
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.13 || ^11.0 || ^12.0",
        "friendsofphp/php-cs-fixer": "^3.62",
        "graham-campbell/testbench": "^6.3",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "illuminate/contracts": "Required to use the Laravel service provider and facade (^12.0 || ^13.0). Already present in any Laravel application.",
        "illuminate/support": "Required to use the Laravel service provider and facade (^12.0 || ^13.0). Already present in any Laravel application."
    },
    "autoload": {
        "psr-4": {
            "Cloudflare\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cloudflare\\Tests\\": "test/Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse",
        "coverage": [
            "vendor/bin/phpunit --coverage-clover=clover.xml --coverage-text",
            "php bin/check-coverage.php"
        ],
        "fix": "vendor/bin/php-cs-fixer fix",
        "docs:generate-client": "php bin/generate-client-docs.php",
        "docs:generate-coverage": "php bin/generate-coverage-docs.php",
        "docs:generate-links": "php bin/generate-doc-links.php",
        "docs:check-links": "php bin/check-doc-links.php",
        "docs:refresh-schema": "php bin/refresh-cloudflare-schema.php",
        "docs:generate": [
            "@docs:generate-links",
            "@docs:generate-client",
            "@docs:generate-coverage"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cloudflare\\CloudflareServiceProvider"
            ]
        }
    }
}
